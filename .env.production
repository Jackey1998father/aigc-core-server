# ============================================================
# AIGC Core Server 生产环境配置（Docker 部署用）
# Docker 启动时通过 APP_ENV=production 自动加载此文件
# ============================================================

# ===== 基本信息 =====
PROJECT_NAME=AIGC Core Server
VERSION=0.1.0
API_V1_PREFIX=/api/v1
DEBUG=false

# ===== 服务器配置 =====
HOST=0.0.0.0
PORT=8000
WORKERS=4

# ===== CORS 配置 =====
# 生产环境请指定具体域名，多个域名用英文逗号分隔
CORS_ORIGINS=*
CORS_CREDENTIALS=true
CORS_METHODS=*
CORS_HEADERS=*

# ===== 安全配置 =====
# 接口 Bearer Token 鉴权（强烈建议设置强随机字符串）
API_SECRET_TOKEN=
SECRET_KEY=change-me-please-in-production

# ===== 日志配置 =====
LOG_LEVEL=info
LOG_FILE=/var/log/aigc-server/app.log

# ===== 限流配置 =====
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_ENABLED=true

# ===== 上游模型服务 =====
SILICON_FLOW_URL=https://api.siliconflow.cn/v1/chat/completions
SILICON_FLOW_EMBEDDING_URL=https://api.siliconflow.cn/v1/embeddings
SILICON_FLOW_RERANK_URL=https://api.siliconflow.cn/v1/rerank
DEFAULT_MODEL=deepseek-ai/DeepSeek-V4-Flash
DEFAULT_EMBEDDING_MODEL=BAAI/bge-m3
DEFAULT_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 生产环境 API Key 请替换为真实值，或通过请求头传入
SILICON_FLOW_API_KEY=sk-lbaejguljpqjckzkqtaybqnjxzzjizfqyijkxfwatbxrglnv

# ===== Milvus 配置 =====
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=aigc_milvus
MILVUS_USER=
MILVUS_PASSWORD=

# ===== 服务配置 =====
SERVER_BASE_URL=http://106.14.181.222:8000

# ===== MySQL 配置（aliyun: aigc-server）=====

MYSQL_HOST=106.14.181.222
MYSQL_PORT=3306
MYSQL_USER=admin
MYSQL_PASSWORD=981218Dg!
MYSQL_DATABASE=aigc

# ===== Redis 配置（Celery 消息队列）=====
REDIS_HOST=106.14.181.222
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
